services:
  69-s2-db:
    image: postgres:16-alpine
    container_name: 69-s2-db
    environment:
      POSTGRES_USER: pattarakorn
      POSTGRES_PASSWORD: 123456
      POSTGRES_DB: pattarakorn
    ports:
      - "54321:5432"

  69-s2-admin:
    image: dpage/pgadmin4
    container_name: 69-s2-admin
    environment:
      PGADMIN_DEFAULT_EMAIL: pattarakorn-sa@rmutp.ac.th
      PGADMIN_DEFAULT_PASSWORD: 123456
    ports:
      - "8082:80"

  69-s2-app:
    image: prawee/strapi
    container_name: 69-s2-app
    ports:
      - "9092:1337"
    environment:
      DATABASE_CLIENT: postgres
      DATABASE_HOST: 69-s2-db
      DATABASE_PORT: 54321
      DATABASE_NAME: strapi
      DATABASE_USERNAME: pattarakorn
      DATABASE_PASSWORD: 123456
    depends_on:
      - 69-s2-db
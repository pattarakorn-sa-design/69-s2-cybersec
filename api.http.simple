# REST Client

## Variables
@port = 9092
@admin_email = {{$dotenv ADMIN_EMAIL}} 
@admin_password = {{$dotenv ADMIN_PASSWORD}} 
@user_email = {{$dotenv USER_EMAIL}}
@user_password = {{$dotenv USER_PASSWORD}}

@admin_jwt_token = <your-admin-jwt-token>
@user_jwt_token = <your-user-jwt-token>
@reset_code = <reset-code-from-email>
@student_id = 1
@subject_id = 1
@teacher_id = 1

### ========================================
## 1. Admin
### ========================================

### 1.1 Login
POST http://localhost:{{port}}/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}

### 1.2 Register (admin) one time for first time to create admin account
POST http://localhost:{{port}}/admin/register-admin
Content-Type: application/json

{
    "firstname": "Pattarakorn",
    "lastname": "Saneha",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
}

### 1.3 Forgot Password
POST http://localhost:{{port}}/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.1 Reset Password (นำ code ที่ได้จาก Email มาใส่ในตัวแปร @reset_code)
POST http://localhost:{{port}}/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{reset_code}}",
    "password": "{{admin_password}}"
}

### 1.4 Profile
GET http://localhost:{{port}}/admin/users/me
Authorization: Bearer {{admin_jwt_token}}


### ========================================
## 2. User (API)
### ========================================

### 2.1 Login
POST http://localhost:{{port}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.2 Register (ปิดการสมัครเองแล้ว จะได้ 403 ผู้ดูแลต้องสร้างบัญชีให้)
POST http://localhost:{{port}}/api/auth/local/register
Content-Type: application/json

{
    "username": "UserTest",
    "email": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password
POST http://localhost:{{port}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}

### 2.3.1 Reset Password (สำหรับฝั่ง User)
POST http://localhost:{{port}}/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{reset_code}}",
    "password": "{{user_password}}",
    "passwordConfirmation": "{{user_password}}"
}

### 2.4 Profile
GET http://localhost:{{port}}/api/users/me
Authorization: Bearer {{user_jwt_token}}


### ========================================
## 3. Content (ใช้ user_jwt_token จากข้อ 2.1)
### ========================================

### ---------- 3.1 Student ----------

### 3.1.1 Create
POST http://localhost:{{port}}/api/students
Authorization: Bearer {{user_jwt_token}}
Content-Type: application/json

{
    "data": {
        "name": "Student Test",
        "cardId": "1234567890123",
        "mobile": "0812345678"
    }
}

### 3.1.2 List All
GET http://localhost:{{port}}/api/students
Authorization: Bearer {{user_jwt_token}}

### 3.1.3 List with ID
GET http://localhost:{{port}}/api/students/{{student_id}}
Authorization: Bearer {{user_jwt_token}}

### 3.1.4 Update
PUT http://localhost:{{port}}/api/students/{{student_id}}
Authorization: Bearer {{user_jwt_token}}
Content-Type: application/json

{
    "data": {
        "name": "Student Test (updated)",
        "mobile": "0898765432"
    }
}

### ---------- 3.2 Subject ----------

### 3.2.1 Create
POST http://localhost:{{port}}/api/subjects
Authorization: Bearer {{user_jwt_token}}
Content-Type: application/json

{
    "data": {
        "name": "Cyber Security"
    }
}

### 3.2.2 List All
GET http://localhost:{{port}}/api/subjects
Authorization: Bearer {{user_jwt_token}}

### 3.2.3 List with ID
GET http://localhost:{{port}}/api/subjects/{{subject_id}}
Authorization: Bearer {{user_jwt_token}}

### 3.2.4 Update
PUT http://localhost:{{port}}/api/subjects/{{subject_id}}
Authorization: Bearer {{user_jwt_token}}
Content-Type: application/json

{
    "data": {
        "name": "Cyber Security (updated)"
    }
}

### ---------- 3.3 Teacher ----------

### 3.3.1 Create
POST http://localhost:{{port}}/api/teachers
Authorization: Bearer {{user_jwt_token}}
Content-Type: application/json

{
    "data": {
        "name": "Teacher Test"
    }
}

### 3.3.2 List All
GET http://localhost:{{port}}/api/teachers
Authorization: Bearer {{user_jwt_token}}

### 3.3.3 List with ID
GET http://localhost:{{port}}/api/teachers/{{teacher_id}}
Authorization: Bearer {{user_jwt_token}}

### 3.3.4 Update
PUT http://localhost:{{port}}/api/teachers/{{teacher_id}}
Authorization: Bearer {{user_jwt_token}}
Content-Type: application/json

{
    "data": {
        "name": "Teacher Test (updated)"
    }
}

# REST Client

## Variables
@port = {{$dotenv APP_PORT}}

@admin_email = {{$dotenv ADMIN_EMAIL}}
@admin_password = {{$dotenv ADMIN_PASSWORD}}
@admin_firstname = {{$dotenv ADMIN_FIRSTNAME}}
@admin_lastname = {{$dotenv ADMIN_LASTNAME}}
@admin_reset_code = {{$dotenv ADMIN_RESET_CODE}}

@user_username = {{$dotenv USER_USERNAME}}
@user_email = {{$dotenv USER_EMAIL}}
@user_password = {{$dotenv USER_PASSWORD}}
@user_reset_code = {{$dotenv USER_RESET_CODE}}

### ========================================
## 1. Admin
### ========================================

### 1.1 Login
# @name adminLogin
POST http://localhost:{{port}}/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}

### 1.2 Register (admin) one time for first time to create admin account
POST http://localhost:{{port}}/admin/register-admin
Content-Type: application/json

{
    "firstName": "{{admin_firstname}}",
    "lastName": "{{admin_lastname}}",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "confirmPassword": "{{admin_password}}"
}

### 1.2.1 Register (admin alternate route)
# Use this only if /admin/register-admin is not available in your Strapi version.
POST http://localhost:{{port}}/admin/register
Content-Type: application/json

{
    "firstName": "{{admin_firstname}}",
    "lastName": "{{admin_lastname}}",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "confirmPassword": "{{admin_password}}"
}

### 1.3 Forgot Password (Admin)
# Run this request first. Then copy the reset code from email or server log into ADMIN_RESET_CODE in .env.
POST http://localhost:{{port}}/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.1 Forgot Password (Admin alternate route)
# Use this only if /admin/forgot-password is not available in your Strapi version.
POST http://localhost:{{port}}/admin/auth/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.2 Reset Password (Admin)
# Requires ADMIN_RESET_CODE from the forgot-password email/link.
POST http://localhost:{{port}}/admin/reset-password
Content-Type: application/json

{
    "code": "{{admin_reset_code}}",
    "password": "{{admin_password}}",
    "passwordConfirmation": "{{admin_password}}"
}

### 1.3.3 Reset Password (Admin alternate route)
# Use this only if /admin/reset-password is not available in your Strapi version.
POST http://localhost:{{port}}/admin/auth/reset-password
Content-Type: application/json

{
    "code": "{{admin_reset_code}}",
    "password": "{{admin_password}}",
    "passwordConfirmation": "{{admin_password}}"
}

### 1.4 Profile
GET http://localhost:{{port}}/admin/users/me
Authorization: Bearer {{adminLogin.response.body.$.data.token}}


### ========================================
## 2. User (API)
### ========================================

### 2.1 Login
# @name userLogin
POST http://localhost:{{port}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.2 Register
POST http://localhost:{{port}}/api/auth/local/register
Content-Type: application/json

{
    "username": "{{user_username}}",
    "email": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password (User)
# Run this request first. Then copy the reset code from email or server log into USER_RESET_CODE in .env.
POST http://localhost:{{port}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}

### 2.3.1 Reset Password (User)
# Requires USER_RESET_CODE from the forgot-password email/link.
POST http://localhost:{{port}}/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{user_reset_code}}",
    "password": "{{user_password}}",
    "passwordConfirmation": "{{user_password}}"
}

### 2.4 Profile
GET http://localhost:{{port}}/api/users/me
Authorization: Bearer {{userLogin.response.body.$.jwt}}
